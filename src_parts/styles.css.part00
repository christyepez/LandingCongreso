:root{
  --ink:#111114;--paper:#f4f1eb;--white:#fff;--purple:#3c235f;--purple2:#684c86;--yellow:#ffd82f;--muted:#747078;--line:rgba(17,17,20,.13);
}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:var(--paper);color:var(--ink);font-family:Manrope,system-ui,sans-serif}.site-shell{overflow:hidden}.topbar{height:86px;padding:0 clamp(24px,5vw,76px);display:flex;align-items:center;justify-content:space-between;background:rgba(244,241,235,.86);backdrop-filter:blur(16px);position:fixed;top:0;left:0;right:0;z-index:50;border-bottom:1px solid rgba(17,17,20,.08)}.brand{display:flex;align-items:center;gap:11px;text-decoration:none;color:var(--ink)}.brand-mark{display:grid;place-items:center;width:34px;height:34px;border-radius:50% 50% 45% 55%;background:var(--purple);color:#fff;font-family:'Space Grotesk';font-weight:700}.brand-copy{display:flex;flex-direction:column;line-height:1}.brand-copy strong{font-family:'Space Grotesk';font-size:14px;letter-spacing:.04em}.brand-copy small{font-size:9px;letter-spacing:.2em;margin-top:5px}.nav{display:flex;gap:34px}.nav a{font-size:13px;text-decoration:none;color:#38343a;font-weight:600}.nav a:hover{color:var(--purple)}.btn{display:inline-flex;align-items:center;justify-content:center;gap:22px;text-decoration:none;border-radius:2px;padding:16px 22px;font-size:13px;font-weight:800;letter-spacing:.02em;transition:.2s ease}.btn:hover{transform:translateY(-2px)}.btn-primary{background:var(--purple);color:#fff}.btn-small{padding:12px 18px}.btn-ghost{border:1px solid rgba(255,255,255,.25);color:#fff}.btn-light{background:#fff;color:var(--ink)}.menu-btn{display:none;border:0;background:none;font-size:24px}.hero{min-height:800px;padding:160px clamp(24px,7vw,112px) 80px;background:#121015;color:#fff;position:relative;display:grid;grid-template-columns:1.45fr .55fr;align-items:center;gap:70px}.hero-grid,.cta-grid{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.035) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.035) 1px,transparent 1px);background-size:70px 70px;mask-image:linear-gradient(to bottom,rgba(0,0,0,.9),transparent)}.hero-glow{position:absolute;border-radius:50%;filter:blur(30px);opacity:.45}.hero-glow-a{width:520px;height:520px;background:radial-gradient(circle,var(--purple2),transparent 68%);right:-130px;top:130px}.hero-glow-b{width:300px;height:300px;background:radial-gradient(circle,var(--yellow),transparent 70%);right:16%;bottom:-180px;opacity:.14}.hero-content,.event-card{position:relative;z-index:2}.eyebrow,.kicker{font-size:11px;font-weight:800;letter-spacing:.18em;text-transform:uppercase}.eyebrow{color:#d5cfe0;display:flex;align-items:center;gap:10px}.eyebrow span{width:32px;height:2px;background:var(--yellow)}h1,h2,h3{font-family:'Space Grotesk',sans-serif;margin:0}h1{font-size:clamp(55px,6.7vw,108px);line-height:.91;letter-spacing:-.055em;max-width:1040px;margin:30px 0 28px}h1 em{font-style:normal;color:var(--yellow)}.hero-lead{max-width:740px;font-size:18px;line-height:1.65;color:#c8c3cc}.hero-actions{display:flex;gap:12px;margin-top:38px}.hero-proof{display:flex;gap:58px;margin-top:60px;padding-top:30px;border-top:1px solid rgba(255,255,255,.15);max-width:760px}.hero-proof div{display:flex;flex-direction:column}.hero-proof strong{font-family:'Space Grotesk';font-size:30px}.hero-proof span{font-size:11px;color:#aaa3af;margin-top:5px}.event-card{background:rgba(255,255,255,.07);border:1px solid rgba(255,255,255,.15);backdrop-filter:blur(18px);padding:30px;min-width:300px}.event-card-head{font-size:10px;letter-spacing:.2em;font-weight:800;display:flex;justify-content:space-between}.event-card-head span{color:var(--yellow)}.event-date{display:grid;grid-template-columns:auto auto 1fr auto auto;align-items:baseline;gap:8px;margin:42px 0 28px}.event-date span{font:700 46px 'Space Grotesk'}.event-date small{font-weight:800;color:var(--yellow)}.event-date i{height:1px;background:rgba(255,255,255,.3);margin:0 5px}.event-card p{line-height:1.7;color:#ddd8e2;font-size:13px}.event-card-line{height:1px;background:rgba(255,255,255,.15);margin:26px 0}.event-tags{display:flex;flex-wrap:wrap;gap:8px}.event-tags span{font-size:10px;border:1px solid rgba(255,255,255,.18);padding:7px 9px}.scroll-note{position:absolute;left:24px;bottom:60px;writing-mode:vertical-rl;font-size:9px;letter-spacing:.18em;color:#89828e}.ticker{height:64px;background:var(--yellow);display:flex;align-items:center;white-space:nowrap;overflow:hidden;font:800 12px 'Space Grotesk';letter-spacing:.15em}.ticker div{animation:ticker 22s linear infinite}.ticker span{margin:0 26px}@keyframes ticker{to{transform:translateX(-50%)}}.section{padding:110px clamp(24px,7vw,112px)}.section-number{font-size:10px;font-weight:800;letter-spacing:.18em;color:#817b84;margin-bottom:56px}.section-number.light{color:#b8aee8}.intro-copy{display:grid;grid-template-columns:1.45fr .7fr;gap:120px}.kicker{color:var(--purple);margin:0 0 18px}.intro h2,.section-heading h2,.venue h2{font-size:clamp(42px,5vw,76px);line-height:.98;letter-spacing:-.045em}.body-copy{padding-top:32px;font-size:16px;line-height:1.75;color:#575159}.body-copy p:first-child{font-weight:700;color:#29252a}.impact{display:grid;grid-template-columns:1.3fr .65fr .65fr;grid-template-rows:auto auto;gap:1px;background:var(--line);padding:1px;margin:0 clamp(24px,7vw,112px) 110px}.impact article{background:var(--paper);padding:42px}.impact-main{grid-row:1/3}.impact-main h3{font-size:54px;line-height:1;margin:45px 0 100px}.impact-main p{max-width:420px;line-height:1.7;color:#5e5960}.mini-label{font-size:10px;letter-spacing:.18em;color:var(--purple);font-weight:800}.metric-card{display:flex;flex-direction:column;justify-content:space-between;min-height:230px}.metric-card strong{font:700 58px 'Space Grotesk';letter-spacing:-.04em}.metric-card span{font-size:12px;max-width:160px;line-height:1.5;color:#6b656d}.metric-card.wide{grid-column:2/4;min-height:190px;flex-direction:row;align-items:flex-end}.metric-card.wide span{max-width:260px}.experience{background:#ebe7df}.section-heading{display:grid;grid-template-columns:1fr 1.7fr;gap:60px;align-items:end;margin-bottom:65px}.experience-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.feature-card{background:#fff;padding:30px;min-height:330px;display:flex;flex-direction:column;position:relative}.feature-card b{font:600 12px 'Space Grotesk';color:#99929c}.feature-card h3{font-size:28px;line-height:1.05;margin-top:auto;margin-bottom:18px}.feature-card p{font-size:13px;line-height:1.65;color:#69636b;margin:0 35px 0 0}.feature-card>span{position:absolute;right:24px;bottom:24px}.feature-dark{background:#17131a;color:#fff}.feature-dark p{color:#bcb5c1}.feature-accent{background:var(--purple);color:#fff}.feature-accent p,.feature-accent b{color:#ddd2ed}.audience-band{background:var(--purple);color:#fff;padding:100px clamp(24px,7vw,112px)}.audience-content{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}.audience-content h2{font-size:clamp(44px,5.4vw,80px);line-height:.95;letter-spacing:-.05em}.audience-tags{display:flex;flex-wrap:wrap;gap:10px}.audience-tags span{border:1px solid rgba(255,255,255,.28);padding:13px 16px;font-size:11px;font-weight:800;letter-spacing:.06em}.agenda-head{grid-template-columns:1.6fr .65fr}.agenda-note{font-size:12px;line-height:1.65;color:#78717b}.agenda-days{display:grid;grid-template-columns:1fr 1fr;gap:14px}.day-card{border:1px solid var(--line);padding:38px;min-height:430px}.day-card.active{background:#17131a;color:#fff}.day-top{display:flex;justify-content:space-between;border-bottom:1px solid currentColor;padding-bottom:20px;opacity:.8}.day-top small{letter-spacing:.16em}.day-top strong{font:700 18px 'Space Grotesk'}.day-card h3{font-size:42px;margin:60px 0 34px}.day-card ul{list-style:none;padding:0;margin:0}.day-card li{padding:12px 0;border-top:1px solid rgba(128,128,128,.18);font-size:13px}.venue{display:grid;grid-template-columns:1.3fr .7fr;min-height:650px;padding-top:0;padding-bottom:0}.venue-visual{background:#dcd6cc;position:relative;overflow:hidden;min-height:600px}.map-lines{position:absolute;inset:-50px;background:repeating-radial-gradient(ellipse at 60% 50%,transparent 0 18px,rgba(17,17,20,.1) 19px 20px);transform:rotate(-12deg)}.map-pin{position:absolute;left:58%;top:48%;width:72px;height:72px;background:var(--purple);color:#fff;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:grid;place-items:center;box-shadow:0 10px 30px rgba(60,35,95,.25)}.map-pin span{transform:rotate(45deg);font:700 18px 'Space Grotesk'}.coords{position:absolute;bottom:24px;left:24px;font-size:9px;letter-spacing:.2em}.venue-copy{background:var(--yellow);padding:70px 60px;display:flex;flex-direction:column;justify-content:center}.venue-copy .section-number{margin-bottom:auto}.venue-copy .kicker{color:#594d00}.venue-copy p:not(.kicker){font-size:14px;line-height:1.7;max-width:400px}.text-link{margin-top:28px;color:var(--ink);font-size:12px;font-weight:800;text-decoration:none;border-bottom:1px solid;width:max-content;padding-bottom:5px}.organizer-row{display:grid;grid-template-columns:repeat(3,1fr);border:1px solid var(--line)}.org{min-height:240px;padding:34px;border-right:1px solid var(--line);display:flex;justify-content:space-between;align-items:flex-end}.org:last-child{border:0}.org span{font:700 46px 'Space Grotesk';color:#625d64}.org p{font-size:11px;line-height:1.5;text-align:right}.org-ui span{color:var(--purple)}.cta{background:var(--purple);color:#fff;padding:120px 24px;text-align:center;position:relative}.cta>*{position:relative;z-index:1}.cta .kicker{color:var(--yellow)}.cta h2{font-size:clamp(54px,7vw,104px);line-height:.9;letter-spacing:-.055em;margin:24px auto;max-width:1050px}.cta p:not(.kicker){color:#d9d0e4;margin:0 auto 35px}.cta-grid{opacity:.35}footer{background:#111014;color:#fff;padding:38px clamp(24px,5vw,76px);display:grid;grid-template-columns:1fr 1fr 1fr;align-items:center}.footer-brand{color:#fff}.footer-copy{font-size:10px;color:#8f8993;text-align:center}.back-top{color:#fff;font-size:9px;text-decoration:none;letter-spacing:.15em;text-align:right}
@media(max-width:980px){.nav{display:none}.menu-btn{display:block}.topbar>.btn{display:none}.hero{grid-template-columns:1fr;padding-top:140px}.event-card{max-width:420px}.hero-proof{gap:26px}.scroll-note{display:none}.intro-copy,.section-heading,.audience-content,.venue{grid-template-columns:1fr;gap:40px}.impact{grid-template-columns:1fr 1fr}.impact-main{grid-column:1/3;grid-row:auto}.metric-card.wide{grid-column:1/3}.experience-grid{grid-template-columns:1fr 1fr}.venue-copy{min-height:500px}.organizer-row{grid-template-columns:1fr}.org{border-right:0;border-bottom:1px solid var(--line)}}
@media(max-width:650px){.topbar{height:72px}.hero{min-height:auto;padding:120px 22px 60px}.hero-actions,.hero-proof{flex-direction:column}.hero-proof{gap:18px}.hero-proof div{flex-direction:row;align-items:baseline;gap:12px}.event-card{min-width:0}.section{padding:78px 22px}.impact{margin:0 22px 78px;grid-template-columns:1fr}.impact-main,.metric-card.wide{grid-column:auto}.metric-card.wide{flex-direction:column;align-items:flex-start}.experience-grid,.agenda-days{grid-template-columns:1fr}.section-heading{grid-template-columns:1fr}.audience-band{padding:78px 22px}.audience-content{grid-template-columns:1fr}.venue{display:block;padding:0}.venue-visual{min-height:430px}.venue-copy{padding:55px 28px}.organizers{padding-left:22px;padding-right:22px}.cta{padding:90px 22px}footer{grid-template-columns:1fr;gap:22px;text-align:center}.back-top,.footer-copy{text-align:center}.footer-brand{justify-content:center}}

/* Speakers */
