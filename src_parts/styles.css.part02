.firm-logo-card span{
  font-size:8px;
  line-height:1.2;
  letter-spacing:.09em;
  text-align:center;
  min-height:19px;
  display:flex;
  align-items:center;
  justify-content:center;
}
.media-partners{margin-top:46px;padding-top:30px;border-top:1px solid rgba(255,255,255,.13);}
.media-logo-row{
  display:grid;
  grid-template-columns:repeat(7,minmax(0,1fr));
  gap:10px;
  align-items:center;
}
.media-logo-row img{
  display:block;
  width:100%;
  height:74px;
  object-fit:contain;
  padding:14px;
  background:#fff;
  border-radius:7px;
}

@media(max-width:1100px){
  .firms-logo-grid{grid-template-columns:repeat(4,minmax(0,1fr));}
  .media-logo-row{grid-template-columns:repeat(4,minmax(0,1fr));}
}
@media(max-width:980px){
  .hero.hero-video{grid-template-columns:1fr;padding:108px 32px 44px;gap:28px;}
  .hero-content{max-width:760px;}
  .event-card{width:100%;max-width:760px;display:grid;grid-template-columns:auto 1fr;column-gap:24px;align-items:center;}
  .event-card-head,.event-date{grid-column:1;}
  .event-card p,.event-card-line,.event-tags,.event-cover-thumb{grid-column:2;}
  .event-card-line{display:none;}
  .event-cover-thumb{margin-top:10px;}
}
@media(max-width:700px){
  .hero.hero-video{padding:92px 20px 34px;}
  .hero h1{font-size:clamp(34px,10vw,48px);line-height:1.03;}
  .hero-lead{font-size:14px;}
  .hero-proof{grid-template-columns:1fr;gap:12px;}
  .hero-proof div{border-right:0;border-bottom:1px solid rgba(255,255,255,.12);padding:0 0 10px;margin:0;display:flex;align-items:baseline;gap:10px;}
  .hero-proof div:last-child{border-bottom:0;padding-bottom:0;}
  .event-card{display:block;width:100%;padding:18px;}
  .event-date{margin:16px 0 12px;}
  .event-cover-thumb{aspect-ratio:16/8;}
  .firms-band{padding:68px 20px;}
  .firms-logo-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
  .firm-logo-card{height:104px;min-height:104px;padding:12px 10px;}
  .firm-logo-card img{max-width:118px;height:44px;max-height:44px;}
  .media-logo-row{grid-template-columns:repeat(2,minmax(0,1fr));gap:8px;}
  .media-logo-row img{height:66px;padding:12px;}
}

/* V11 · Hero estable + responsive total + speakers normalizados */
html,body{width:100%;max-width:100%;overflow-x:hidden}
.site-shell,main{width:100%;max-width:100%;overflow-x:hidden}

.hero.hero-video{
  position:relative;
  isolation:isolate;
  width:100%;
  max-width:100vw;
  min-height:560px;
  height:min(680px,74vh);
  padding:118px clamp(24px,6vw,96px) 54px;
  display:flex;
  align-items:center;
  justify-content:flex-start;
  overflow:hidden;
}
.hero-media{
  position:absolute!important;
  inset:0!important;
  width:100%!important;
  height:100%!important;
  max-width:none!important;
  z-index:0!important;
  overflow:hidden!important;
  pointer-events:none;
}
.hero-video-bg{
  position:absolute;
  inset:0;
  display:block;
  width:100%!important;
  height:100%!important;
  min-width:100%!important;
  min-height:100%!important;
  max-width:none!important;
  object-fit:cover!important;
  object-position:center center!important;
  transform:none!important;
}
.hero-video-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(90deg,rgba(15,9,22,.96) 0%,rgba(15,9,22,.90) 38%,rgba(15,9,22,.72) 64%,rgba(15,9,22,.42) 100%),linear-gradient(180deg,rgba(15,9,22,.16),rgba(15,9,22,.68));
}
.hero-grid,.hero-glow{pointer-events:none}
.hero-content{
  position:relative;
  z-index:3;
  width:min(100%,820px);
  max-width:820px;
  margin:0;
  padding:0;
}
.hero .eyebrow{margin-bottom:14px;max-width:100%;}
.hero h1{
  max-width:800px;
  margin:0 0 18px;
  font-size:clamp(40px,4.2vw,64px);
  line-height:1.02;
  letter-spacing:-.04em;
  text-wrap:balance;
}
.hero-lead{max-width:650px;font-size:15px;line-height:1.58;}
.hero-actions{margin-top:22px;}
.hero-proof{max-width:650px;margin-top:26px;padding-top:17px;}
/* La tarjeta lateral duplicaba información y forzaba el ancho del hero. */
.hero .event-card{display:none!important;}

/* Speakers: una proporción fija y predecible en todas las tarjetas */
.speaker-grid{grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;align-items:stretch;}
.speaker-card{
  min-width:0;
  min-height:0;
  padding:0!important;
  display:flex;
  flex-direction:column;
  overflow:hidden;
}
.speaker-photo{
  display:block;
  width:100%;
  height:auto;
  aspect-ratio:4/3;
  object-fit:cover;
  object-position:center 24%;
  flex:0 0 auto;
  background:#e9e4ec;
}
.speaker-meta{padding:20px 20px 22px;display:flex;flex-direction:column;flex:1;}
.speaker-meta h3{font-size:clamp(18px,1.45vw,24px);margin:8px 0 10px;}
.speaker-meta p{font-size:11px;line-height:1.5;}

/* Responsive integral */
@media(max-width:1180px){
  .topbar{padding-inline:28px}.nav{gap:20px}
  .speaker-grid{grid-template-columns:repeat(3,minmax(0,1fr));}
  .hero.hero-video{height:auto;min-height:540px;padding:112px 44px 48px;}
}
@media(max-width:980px){
  .hero.hero-video{height:auto;min-height:520px;padding:106px 30px 42px;display:flex;}
  .hero-content{width:min(100%,760px);}
  .hero h1{font-size:clamp(38px,7vw,58px);max-width:720px;}
  .hero-video-bg{object-position:58% center!important;}
  .hero-video-overlay{background:linear-gradient(90deg,rgba(15,9,22,.96) 0%,rgba(15,9,22,.88) 58%,rgba(15,9,22,.60) 100%);}
  .speaker-grid{grid-template-columns:repeat(2,minmax(0,1fr));}
  .speaker-photo{aspect-ratio:16/11;object-position:center 22%;}
  .section,.audience-band{padding-left:30px;padding-right:30px;}
}
@media(max-width:720px){
  .hero.hero-video{min-height:0;padding:94px 20px 34px;}
  .hero-content{width:100%;}
  .hero h1{font-size:clamp(33px,10.2vw,46px);line-height:1.04;max-width:100%;}
  .hero-lead{font-size:14px;max-width:100%;}
  .hero-actions{display:grid;grid-template-columns:1fr;gap:9px;}
  .hero-actions .btn{width:100%;}
  .hero-proof{grid-template-columns:repeat(3,minmax(0,1fr));gap:0;}
  .hero-proof div{display:block;border-right:1px solid rgba(255,255,255,.14);border-bottom:0;padding:0 10px 0 0;margin:0 10px 0 0;}
  .hero-proof strong{font-size:19px}.hero-proof span{font-size:8px}
  .hero-video-bg{object-position:66% center!important;}
  .hero-video-overlay{background:rgba(15,9,22,.78);}
  .speaker-grid{grid-template-columns:1fr;gap:12px;}
  .speaker-card{display:grid;grid-template-columns:122px minmax(0,1fr);}
  .speaker-photo{width:122px;height:100%;aspect-ratio:auto;object-fit:cover;object-position:center 20%;}
  .speaker-meta{padding:16px;}
  .speaker-meta h3{font-size:20px;}
  .section,.audience-band{padding-left:20px;padding-right:20px;}
  .intro-copy,.section-heading,.audience-content,.agenda-days,.venue,.organizer-row{grid-template-columns:1fr;}
}
@media(max-width:460px){
  .hero.hero-video{padding:88px 16px 30px;}
  .hero h1{font-size:clamp(31px,10.8vw,40px);}
  .hero-proof{grid-template-columns:1fr;}
  .hero-proof div{display:flex;align-items:baseline;gap:8px;border-right:0;border-bottom:1px solid rgba(255,255,255,.13);padding:8px 0;margin:0;}
  .hero-proof div:last-child{border-bottom:0;}
  .speaker-card{grid-template-columns:105px minmax(0,1fr);}
  .speaker-photo{width:105px;}
  .speaker-meta{padding:14px;}
  .speaker-meta h3{font-size:18px;}
  .speaker-meta p{font-size:10.5px;}
}

/* V14 · Ajuste puntual de hero: fecha visible a la izquierda + contraste */
.hero.hero-video{
  align-items:center;
}
.hero-content{
  margin-left:0!important;
  margin-right:auto!important;
  text-align:left!important;
}
.hero .eyebrow{
  width:max-content;
  max-width:100%;
  justify-content:flex-start!important;
  align-items:center;
  margin:0 0 16px 0!important;
  padding:8px 12px;
  border-radius:3px;
  background:rgba(15,9,22,.58);
  border:1px solid rgba(255,255,255,.12);
  color:#fff!important;
  text-shadow:0 1px 2px rgba(0,0,0,.8);
  backdrop-filter:blur(8px);
  -webkit-backdrop-filter:blur(8px);
}
.hero .eyebrow span{
  flex:0 0 32px;
  background:#FFD82F!important;
  box-shadow:0 0 0 1px rgba(0,0,0,.08);
}
.hero h1{
  color:#fff!important;
  text-shadow:0 2px 18px rgba(0,0,0,.48);
}
.hero h1 em{
  color:#FFD82F!important;
  text-shadow:0 2px 12px rgba(0,0,0,.45);
}
.hero-lead{
  color:#F4F0F6!important;
  text-shadow:0 1px 10px rgba(0,0,0,.5);
}
.hero-proof strong{color:#fff!important;text-shadow:0 1px 8px rgba(0,0,0,.45)}
.hero-proof span{color:#E4DEE8!important}
.hero-video-overlay{
  background:
    linear-gradient(90deg,rgba(15,9,22,.97) 0%,rgba(15,9,22,.93) 36%,rgba(15,9,22,.78) 62%,rgba(15,9,22,.50) 100%),
    linear-gradient(180deg,rgba(15,9,22,.18),rgba(15,9,22,.72))!important;
}
.btn-ghost{
  background:rgba(15,9,22,.38);
  border-color:rgba(255,255,255,.46)!important;
  color:#fff!important;
  backdrop-filter:blur(5px);
}

@media(max-width:980px){
  .hero .eyebrow{font-size:10px;letter-spacing:.14em;padding:7px 10px;}
  .hero-video-overlay{
    background:linear-gradient(90deg,rgba(15,9,22,.97) 0%,rgba(15,9,22,.92) 66%,rgba(15,9,22,.72) 100%)!important;
  }
}
@media(max-width:720px){
  .hero .eyebrow{width:fit-content;max-width:100%;font-size:9px;line-height:1.35;white-space:normal;}
  .hero-video-overlay{background:rgba(15,9,22,.84)!important;}
}

/* V15 · Cabecera institucional + contraste definitivo del hero */
.topbar{
  background:rgba(60,35,95,.97)!important;
  border-bottom:1px solid rgba(255,255,255,.14)!important;
  box-shadow:0 8px 28px rgba(26,12,42,.14);
  color:#fff;
}
.topbar .brand,
.topbar .brand-event,
.topbar .nav a,
.topbar .menu-btn{color:#fff!important;}
.topbar .nav a{opacity:.92;}
.topbar .nav a:hover,
.topbar .nav a:focus-visible{color:#FFD82F!important;opacity:1;}
.topbar .brand-logo-wrap{
  background:transparent!important;
  padding:6px 0!important;
}
.topbar .btn-primary{
  background:#D7D4DA!important;
  color:#241D2B!important;
  border:1px solid rgba(255,255,255,.34);
  box-shadow:0 5px 16px rgba(0,0,0,.12);
}
.topbar .btn-primary:hover,
.topbar .btn-primary:focus-visible{
  background:#ECEAEC!important;
  color:#3C235F!important;
}
.topbar .menu-btn{padding:8px;border-radius:4px;line-height:1;}

/* El dato de fecha/sede permanece alineado al borde izquierdo del bloque principal. */
.hero-content{justify-self:start!important;align-self:center!important;}
.hero .eyebrow{align-self:flex-start!important;text-align:left!important;}

/* Contraste controlado sobre cualquier fotograma del video. */
.hero-video-overlay{
  background:
    linear-gradient(90deg,rgba(20,10,31,.98) 0%,rgba(20,10,31,.95) 34%,rgba(20,10,31,.84) 58%,rgba(20,10,31,.57) 78%,rgba(20,10,31,.42) 100%),
    linear-gradient(180deg,rgba(18,9,28,.24),rgba(18,9,28,.76))!important;
}
.hero .eyebrow{background:rgba(31,17,46,.78)!important;border-color:rgba(255,255,255,.22)!important;}
.hero-lead{color:#FFFFFF!important;max-width:620px;font-weight:500;}
.hero-proof span{color:#F0EBF4!important;}
.hero .btn-ghost{background:rgba(255,255,255,.10)!important;border-color:rgba(255,255,255,.58)!important;}
.hero .btn-ghost:hover{background:rgba(255,255,255,.18)!important;}

@media(max-width:1180px){
  .topbar{padding-inline:24px;}
  .nav{gap:18px;}
  .nav a{font-size:12px;}
}
@media(max-width:980px){
  .topbar{height:76px;}
  .topbar .brand-logo-wrap img{width:138px;}
  .topbar .menu-btn{display:block!important;}
  .hero.hero-video{padding-top:104px;}
}
@media(max-width:650px){
  .topbar{height:70px;padding-inline:16px;}
  .topbar .brand-logo-wrap img{width:122px;}
  .hero.hero-video{padding-top:88px;}
}

/* V16 · Hero en zona libre izquierda: no tapa la gráfica original */
@media (min-width: 981px){
  .hero.hero-video{
    position:relative;
    display:block!important;
    min-height:560px;
    height:min(680px,74vh);
    padding:0!important;
  }
  .hero-content{
    position:absolute!important;
    z-index:4;
    left:clamp(44px,5.2vw,86px)!important;
    right:auto!important;
    top:50%!important;
    transform:translateY(-46%)!important;
    width:min(44vw,620px)!important;
    max-width:620px!important;
    margin:0!important;
    padding:0!important;
    text-align:left!important;
  }
  .hero .eyebrow{
