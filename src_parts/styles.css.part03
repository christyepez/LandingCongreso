    margin:0 0 14px 0!important;
    width:max-content;
    max-width:100%;
  }
  .hero h1{
    max-width:610px!important;
    font-size:clamp(42px,4.05vw,62px)!important;
    line-height:1.01!important;
    margin:0 0 17px!important;
  }
  .hero-lead{max-width:585px!important;font-size:14px!important;line-height:1.55!important;}
  .hero-actions{margin-top:20px!important;}
  .hero-proof{max-width:590px!important;margin-top:22px!important;padding-top:15px!important;}
  .hero-video-bg{
    object-fit:cover!important;
    object-position:72% center!important;
  }
  .hero-video-overlay{
    background:
      linear-gradient(90deg,
        rgba(18,8,29,.97) 0%,
        rgba(18,8,29,.94) 34%,
        rgba(18,8,29,.77) 48%,
        rgba(18,8,29,.32) 62%,
        rgba(18,8,29,.10) 100%),
      linear-gradient(180deg,rgba(18,8,29,.14),rgba(18,8,29,.52))!important;
  }
}

@media (min-width:981px) and (max-width:1280px){
  .hero-content{
    left:38px!important;
    width:min(46vw,560px)!important;
    max-width:560px!important;
  }
  .hero h1{font-size:clamp(38px,4.1vw,54px)!important;max-width:550px!important;}
  .hero-lead{max-width:525px!important;}
  .hero-proof{max-width:540px!important;}
  .hero-video-bg{object-position:76% center!important;}
}

@media (max-width:980px){
  .hero-content{
    position:relative!important;
    left:auto!important;right:auto!important;top:auto!important;
    transform:none!important;
    width:min(100%,720px)!important;
    max-width:720px!important;
    margin:0!important;
  }
  .hero-video-bg{object-position:68% center!important;}
}
